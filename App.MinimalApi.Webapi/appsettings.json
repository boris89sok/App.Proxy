{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "SecureProxyDb": "Server=(localdb)\\MSSQLLocalDB;Database=SecureProxyDb;Trusted_Connection=True;TrustServerCertificate=False;"
  },
  "AppSettings": {
    "Env": "Dev",
    "Dev": {
      "ApiUrl": "https://restcountries.com"
    },
    "QA": {
      "ApiUrl": "https://restcountries.com"
    },
    "Prod": {
      "ApiUrl": "https://restcountries.com"
    }
  },
  "Proxy": {
    "GlobalMaxRequestBytes": 262144,
    "ConfigCacheSeconds": 30,
    "NegativeCacheSeconds": 5,
    "AllowHttpUpstream": false,
    "Audit": {
      "Mode": "BestEffort",
      "ChannelCapacity": 10000,
      "BatchSize": 100,
      "MaxWriteAttempts": 3
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 20,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15
    }
  },
  "RateLimiting": {
    "TokenLimit": 100,
    "TokensPerSecond": 50,
    "MaxConcurrentRequests": 200
  },
  "Security": {
    "Jwt": {
      "Issuer": "https://auth.example.internal",
      "Audience": "secure-proxy"
    }
  }
}
